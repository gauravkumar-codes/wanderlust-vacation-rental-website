<% layout('layouts/boilerplate') %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
            <h1>Edit Listing</h1>
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" type="text" value="<%= listing.title %>" class="form-control" required>
                    <div class="invalid-feedback">
                        Title is invalid!
                    </div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" type="text" class="form-control" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">
                        Description is invalid!
                    </div>
                </div>
                <div class="mb-3">
                    Original Image <br>
                    <img src="<%= originalImageUrl %>" class="img-thumbnail edit-preview-img">
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Upload New Image</label>
                    <input name="listing[image][url]" type="file" class="form-control">
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select" required>
                        <% 
                        const categories = [
                            "Trending", "Rooms", "Cities", "Mountains", 
                            "Castles", "Pools", "Camping", "Deserts", 
                            "Arctic", "Beaches", "Boats"
                        ];
                        %>

                        <% for(let cat of categories) { %>
                        <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>>
                            <%= cat %>
                        </option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" type="number" value="<%= listing.price %>" class="form-control" required>
                    <div class="invalid-feedback">
                        Price is invalid!
                    </div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" type="text" value="<%= listing.location %>" class="form-control" required>
                        <div class="invalid-feedback">
                            Location is invalid!
                        </div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" type="text" value="<%= listing.country %>" class="form-control" required>
                        <div class="invalid-feedback">
                            Country is invalid!
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-dark edit-btn">Update</button>
            </form>
        </div>
    </div>
    <br>
</body>